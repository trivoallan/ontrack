; Adding a dependency (ADR-0020, rule 2): no version younger than three days
; is installed, the cooldown Dependabot already applies to updates
; (ADR-0018).
;
; npm 11.19, which ships with Node 24, honours this. npm 10, which ships
; with Node 22, ignores it without a word. A `before` date set next to it
; would win over it.
min-release-age=3

; The governance track, installed from the registry under the alias
; `trivoallan`, is left out of the cooldown: a question it revises reaches
; this repository as soon as the track is updated. This departs from rule 2
; of ADR-0020 for this one package, published by the same owner.
min-release-age-exclude[]=@trivoallan/ontrack-governance
