; Adding a dependency (ADR-0020, rule 2): no version younger than three days
; is installed, the cooldown Dependabot already applies to updates
; (ADR-0018).
;
; npm 11.19, which ships with Node 24, honours this. npm 10, which ships
; with Node 22, ignores it without a word. A `before` date set next to it
; would win over it.
min-release-age=3

; The tracks of the same owner, installed from the registry under the aliases
; `engineering` and `product`, are left out of the cooldown: a convention they
; revise reaches this repository as soon as the track is updated.
; local/ADR-0028 records this exception for these two packages.
min-release-age-exclude[]=@trivoallan/ontrack-engineering
min-release-age-exclude[]=@trivoallan/ontrack-product
