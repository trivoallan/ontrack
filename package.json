{
  "name": "@trivoallan/ontrack",
  "version": "0.6.0",
  "description": "Imports shared conventions provided by npm tracks into a repository, and keeps each ruling as an architecture decision record (ADR).",
  "keywords": [
    "adr",
    "architecture-decision-records",
    "architecture",
    "software-architecture",
    "architecture-governance",
    "compliance",
    "governance",
    "policy-as-code",
    "engineering-standards",
    "conventions",
    "drift-detection",
    "agentic",
    "agentic-coding",
    "ai-agents",
    "coding-agents",
    "agents-md",
    "claude-code"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trivoallan/ontrack.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "ontrack": "dist/bin/ontrack.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 --test-coverage-exclude='test/**' 'test/**/*.test.ts'",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "prepare": "npm run build",
    "schema": "node scripts/schema.ts"
  },
  "dependencies": {
    "yargs": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@fission-ai/openspec": "^2.0.0",
    "@types/node": "^22.20.5",
    "@types/yargs": "^17.0.35",
    "engineering": "npm:@trivoallan/ontrack-engineering@^0.6.0",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist/",
    "schema/"
  ]
}
