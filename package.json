{
  "name": "ontrack",
  "version": "0.1.0",
  "description": "Imports shared architecture decision records (ADRs) provided by npm sources into a repository.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "ontrack": "dist/bin/ontrack.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 --test-coverage-exclude='test/**' 'test/**/*.test.ts'",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "prepare": "npm run build"
  },
  "dependencies": {
    "yargs": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^22.20.5",
    "@types/yargs": "^17.0.35",
    "trivoallan": "github:trivoallan/governance",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist/"
  ]
}
